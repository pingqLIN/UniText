{
  "schema_version": "external-audit-orchestrator.tb2.request.v1",
  "request_id": "{{REQUEST_ID}}",
  "workstream_id": "{{WORKSTREAM_ID}}",
  "correlation_id": "{{CORRELATION_ID}}",
  "reviewer_profile": {
    "id": "{{REVIEWER_ID}}",
    "role": "{{REVIEWER_ROLE}}",
    "provider": "{{REVIEWER_PROVIDER}}",
    "model_hint": "{{MODEL_HINT}}",
    "read_only": true
  },
  "audit_mode": "tb2-template-export",
  "scope": {
    "project_path": "{{PROJECT_PATH}}",
    "scope_type": "{{SCOPE_TYPE}}",
    "scope_value": "{{SCOPE_VALUE}}"
  },
  "packet_path": "{{PACKET_PATH}}",
  "packet_sha256": "{{PACKET_SHA256}}",
  "packet_transport": "{{PACKET_TRANSPORT}}",
  "prompt": {{PROMPT_JSON}},
  "packet_inline": {{PACKET_INLINE_JSON}},
  "expected_output_schema": {
    "format": "json",
    "required_sections": [
      "reviewer_id",
      "verdict",
      "findings",
      "assumptions",
      "reference_inputs_used",
      "confidence",
      "requires_rerun"
    ],
    "allowed_verdicts": [
      "accept",
      "fix-and-rerun",
      "escalate-to-human",
      "archive-only"
    ],
    "allowed_severities": [
      "Critical",
      "Warning",
      "Suggestion"
    ],
    "finding_required_fields": [
      "severity",
      "title",
      "location",
      "risk",
      "recommended_action"
    ],
    "result_wrapper_statuses": [
      "completed",
      "timeout",
      "invalid",
      "failed"
    ]
  },
  "timeout_seconds": {{TIMEOUT_SECONDS}},
  "provenance_policy": {
    "require_reference_acknowledgement": true,
    "forbid_uncited_cross_project_claims": true
  },
  "redaction_policy": {
    "store_raw_prompt": {{STORE_RAW_PROMPT_JSON}},
    "store_raw_transcript": false,
    "store_hash_fingerprint": true
  }
}
